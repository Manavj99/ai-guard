# AI-Guard Database Configuration
# Copy this to .env and update with your database credentials

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_guard_db
DB_USER=ai_guard_user
DB_PASSWORD=ai_guard_password

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Flask Configuration
FLASK_SECRET_KEY=ai-guard-enterprise-secret-key-2024
JWT_SECRET_KEY=jwt-secret-key-ai-guard-2024

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# Production Settings (Update for production)
DEBUG=True
ENVIRONMENT=development
